{
  "name": "@caladrius/proto-react",
  "version": "0.3.2",
  "description": "Prototype of the NCA screen in React 19 (T-136): the same build runs in a browser (Web Worker, WebAssembly) and in the Tauri 2 shell.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "tsc --noEmit -p tsconfig.json && node --experimental-strip-types --test \"test/*.test.ts\"",
    "serve": "npm run wasm && npm run build && npm run preview",
    "desktop": "node scripts/desktop.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "dockview-react": "8.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
