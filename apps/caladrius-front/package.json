{
  "name": "@caladrius/front",
  "version": "0.1.0",
  "description": "The web front of Caladrius: React 19, dockview, the engine in a Web Worker (browser) or in the Tauri 2 process (desktop).",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "node scripts/build-wasm.mjs --if-missing && vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve": "npm run wasm && npm run build && npm run preview",
    "test": "tsc --noEmit -p tsconfig.json && node --experimental-strip-types --no-warnings --test \"test/*.test.ts\"",
    "desktop": "node scripts/desktop.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@caladrius/plot": "0.1.0",
    "@caladrius/table": "0.1.0",
    "@tauri-apps/api": "2.12.4",
    "cmdk": "1.1.1",
    "dockview-react": "8.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tinykeys": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
